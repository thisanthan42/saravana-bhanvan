# ==============================================================
# Hotel Customer Feedback SaaS Platform — Environment Variables
# Copy this file to .env inside /backend and /frontend
# NEVER commit real .env files containing secrets to Git!
# ==============================================================

# --------------------------------------------------------------
# 1. BACKEND SERVICE CONFIGURATION (backend/.env)
# --------------------------------------------------------------
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String
# Local: postgresql://postgres:postgres@localhost:5432/saravana_bhavan_db
# Cloud (Neon/Render/Supabase): postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saravana_bhavan_db

# Allowed Frontend Origins for CORS (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Public Frontend URL (Encoded into customer table QR codes)
# Local: http://localhost:3000
# Production: https://feedback.yourhotel.com
PUBLIC_APP_URL=http://localhost:3000

# Manager JWT Secret Key (Use 64-char high-entropy string in production)
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars-long

# Initial Default Super Admin Credentials (Seeded on first migration)
DEFAULT_MANAGER_NAME=Hotel General Manager
DEFAULT_MANAGER_EMAIL=manager@saravanabhavan.com
DEFAULT_MANAGER_PASSWORD=test123

# --------------------------------------------------------------
# 2. FRONTEND CLIENT CONFIGURATION (frontend/.env)
# --------------------------------------------------------------
# Local: http://localhost:5000
# Production: https://api.yourhotel.com
VITE_API_URL=http://localhost:5000
