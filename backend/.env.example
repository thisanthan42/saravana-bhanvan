# ==============================================================
# Saravana Bhavan Hotel Backend Environment Configuration
# Copy this file to .env and replace placeholders with your credentials
# DO NOT commit your real .env file with secrets to Git!
# ==============================================================

# Server Port (Render/Heroku sets this automatically in production)
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# PostgreSQL Connection String
# Local PostgreSQL:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/saravana_bhavan_db
# Cloud PostgreSQL (Neon / Supabase / Render / AWS RDS):
# DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/saravana_bhavan_db?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/saravana_bhavan_db

# Frontend Client URL(s) allowed by CORS
# In production, set to your deployed frontend domain (comma-separated if multiple):
# CORS_ORIGIN=https://feedback.saravanabhavan.com,https://saravana-bhavan-feedback.vercel.app
CORS_ORIGIN=http://localhost:3000

# Public App Base URL for QR Generation
# Defines the domain encoded into table QR codes:
# Local development:
PUBLIC_APP_URL=http://localhost:3000
# Production:
# PUBLIC_APP_URL=https://feedback.saravanabhavan.com

# JWT Secret Key (Crucial: Generate a high-entropy 64-char random string in production)
JWT_SECRET=saravana-bhavan-manager-jwt-production-secret-key-2026

# Default Initial Super Admin Credentials (Seeded on first database migration)
DEFAULT_MANAGER_NAME=Saravana Bhavan General Manager
DEFAULT_MANAGER_EMAIL=manager@saravanabhavan.com
DEFAULT_MANAGER_PASSWORD=Saravana@2026!

# Legacy Manager API Key (Optional backward compatibility)
MANAGER_API_SECRET=saravana_secret_manager_key_change_in_production
